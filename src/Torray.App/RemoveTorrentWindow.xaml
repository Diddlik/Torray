<Window x:Class="Torray.App.RemoveTorrentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource RemoveTitle}"
        Icon="Assets/Torray.ico"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=KeepDataButton}">
    <StackPanel Margin="24">
        <TextBlock x:Name="QuestionText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{StaticResource RemoveKeepDataHint}" Margin="0,12,0,0" TextWrapping="Wrap" />
        <TextBlock Text="{StaticResource RemoveDeleteDataHint}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

        <!-- The safe choice is the default; deleting data needs a deliberate click. -->
        <DockPanel Margin="0,24,0,0" LastChildFill="False">
            <Button x:Name="DeleteDataButton" DockPanel.Dock="Left" Content="{StaticResource RemoveDeleteData}"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}" Click="OnDeleteData" />
            <Button DockPanel.Dock="Right" Content="{StaticResource RemoveCancel}" IsCancel="True" MinWidth="80" Margin="8,0,0,0" />
            <Button x:Name="KeepDataButton" DockPanel.Dock="Right" Content="{StaticResource RemoveKeepData}" IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}" Click="OnKeepData" />
        </DockPanel>
    </StackPanel>
</Window>
