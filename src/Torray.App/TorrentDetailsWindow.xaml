<Window x:Class="Torray.App.TorrentDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Torray.App"
        Title="{StaticResource DetailsTitle}"
        Icon="Assets/Torray.ico"
        Width="480" SizeToContent="Height" MaxHeight="640" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,4" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,24,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="{StaticResource AboutClose}" IsCancel="True" IsDefault="True" MinWidth="80"
                    Style="{DynamicResource AccentButtonStyle}" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel Grid.IsSharedSizeScope="True">
                <TextBlock Text="{StaticResource DetailsLoading}" Opacity="0.7"
                           Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="local:DetailRow">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" Opacity="0.7" Margin="0,0,16,0" />
                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0"
                                         AutomationProperties.Name="{Binding Label}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Visibility="{Binding HasDetails, Converter={StaticResource Visible}}">
                    <TextBlock Text="{StaticResource DetailsTrackers}" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding Trackers}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding PeersHeader}" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding Peers}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Margin="0,2" ToolTip="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
