<Window x:Class="Torray.App.WatchFoldersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Torray.App"
        Title="{StaticResource WatchTitle}"
        Icon="Assets/Torray.ico"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="{StaticResource WatchIntro}" TextWrapping="Wrap" />

        <ItemsControl ItemsSource="{Binding Folders}" Margin="0,16,0,0" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="local:WatchFolderItem">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                  AutomationProperties.Name="{Binding Path}" ToolTip="{StaticResource WatchEnabled}" />
                        <StackPanel Grid.Column="1" Margin="4,0,8,0">
                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                            <CheckBox Content="{StaticResource WatchMoveToArchive}" IsChecked="{Binding MoveToArchive}"
                                      Margin="0,4,0,0" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="2" VerticalAlignment="Center" Content="&#xE74D;"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="36" Height="32" Padding="0"
                                AutomationProperties.Name="{StaticResource WatchRemoveFolder}"
                                ToolTip="{StaticResource WatchRemoveFolder}"
                                CommandParameter="{Binding}"
                                Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="{StaticResource WatchAddFolder}" HorizontalAlignment="Left" Command="{Binding AddFolderCommand}" />

        <!-- Uploads that are waiting or failed, so watch-folder problems are never silent -->
        <StackPanel Margin="0,24,0,0" Visibility="{Binding HasIssues, Converter={StaticResource Visible}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{StaticResource WatchRetry}" Command="{Binding RetryCommand}" />
                <TextBlock Text="{StaticResource WatchProblems}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Issues}" Margin="0,8,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="local:WatchIssueItem">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                            <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="0.7" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <DockPanel Margin="0,24,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="{StaticResource ConnectionCancel}" IsCancel="True" MinWidth="80" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="{StaticResource ConnectionSave}" IsDefault="True" MinWidth="80"
                    Style="{DynamicResource AccentButtonStyle}" Command="{Binding SaveCommand}" />
        </DockPanel>
    </StackPanel>
</Window>
