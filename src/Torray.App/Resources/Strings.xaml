    <sys:String x:Key="WatchJobFailed">Not uploaded. {0} The file was kept.</sys:String>
    <sys:String x:Key="WatchSaveFailed">The watch folders could not be saved. Check that %LOCALAPPDATA%\Torray is writable and try again.</sys:String>
    <sys:String x:Key="FlyoutAddMagnet">Add</sys:String>
    <sys:String x:Key="FlyoutOpenTorrent">Open .torrent…</sys:String>
    <sys:String x:Key="FlyoutDropActive">Release to add</sys:String>
    <sys:String x:Key="TorrentFileFilter">Torrent files (*.torrent)|*.torrent</sys:String>

    <sys:String x:Key="TorrentStart">Resume</sys:String>
    <sys:String x:Key="TorrentPause">Pause</sys:String>
    <sys:String x:Key="TorrentRemove">Remove…</sys:String>

