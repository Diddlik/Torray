    <sys:String x:Key="NoticeRemovedWithData">Removed "{0}" and deleted its downloaded files.</sys:String>

    <sys:String x:Key="TorrentInputNotMagnet">That is not a magnet link. Magnet links start with "magnet:?xt=urn:btih:".</sys:String>
    <sys:String x:Key="TorrentInputFileNotFound">The .torrent file no longer exists.</sys:String>
    <sys:String x:Key="TorrentInputFileTooLarge">The file is too large to be a .torrent file (limit 10 MB).</sys:String>
