<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is used only for the tray NotifyIcon, which WPF lacks. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- ThemeMode (Fluent, light/dark following Windows) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <AssemblyName>Torray</AssemblyName>
    <RootNamespace>Torray.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Program.Main owns startup (Velopack hook, single instance, host), so App.xaml must not generate its own Main. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Torray.Domain\Torray.Domain.csproj" />
    <ProjectReference Include="..\Torray.Infrastructure\Torray.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
