<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is used only for the tray NotifyIcon, which WPF lacks. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF0001: ThemeMode (Fluent, light/dark following Windows) is still marked experimental.
         WFO0003: the DPI mode must come from app.manifest because WPF, not WinForms, owns startup. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
    <AssemblyName>Torray</AssemblyName>
    <RootNamespace>Torray.App</RootNamespace>
    <ApplicationIcon>Assets\Torray.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Torray.svg is the icon source; regenerate the .ico with:
       magick -background none -density 384 Torray.svg -define icon:auto-resize=256,64,48,40,32,24,20,16 Torray.ico -->
  <ItemGroup>
    <Resource Include="Assets\Torray.ico" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Program.Main owns startup (Velopack hook, single instance, host), so App.xaml must not generate its own Main. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Torray.Domain\Torray.Domain.csproj" />
    <ProjectReference Include="..\Torray.Infrastructure\Torray.Infrastructure.csproj" />
    <ProjectReference Include="..\Torray.Application\Torray.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
